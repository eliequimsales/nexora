{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^@reshit/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
    "^@reshit/shared/(.*)$": "<rootDir>/../../../packages/shared/src/$1"
  }
}
