# Banco (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/recepcionista"

# Auth — gere um segredo longo: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Login com Google (OAuth) — crie em console.cloud.google.com > Credentials.
# Redirect URI autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."

# ——— IA do Atendente ———
# Provedor: groq (padrão comercial, custo mínimo) | openai | anthropic | ollama
AI_PROVIDER="groq"

# Groq (padrão — crie a chave grátis em console.groq.com)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.1-8b-instant"

# OpenAI (alternativa de baixo custo)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4.1-nano"

# Anthropic/Claude (opção premium — melhor qualidade, maior custo)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"

# Ollama (local/auto-hospedado — custo zero por conversa)
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1"

# WhatsApp (Evolution API v2)
EVOLUTION_API_URL="https://sua-evolution-api.exemplo.com"
EVOLUTION_API_KEY="sua-apikey-global"

# URL pública deste app — usada para configurar o webhook da Evolution
# automaticamente ({APP_URL}/api/webhook/whatsapp?token={WEBHOOK_TOKEN})
APP_URL="https://seu-dominio.exemplo.com"

# Segurança do webhook — configure a URL do webhook na Evolution como:
# https://seu-dominio.com/api/webhook/whatsapp?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN="token-aleatorio-para-validar-webhook"

# Rota manual de follow-up (POST /api/cron/follow-ups com header x-cron-secret)
CRON_SECRET="segredo-para-rota-de-follow-up"

# Intervalo do worker interno de follow-up (minutos)
FOLLOWUP_INTERVAL_MINUTES="5"

# ——— Cobrança (Stripe) ———
# A conta, os contratos e a conta bancária ficam no nome do TITULAR ADULTO.
# Nunca versione valores: só nomes ficam neste arquivo.
STRIPE_SECRET_KEY="sk_..."
# Segredo do endpoint criado em dashboard.stripe.com/webhooks apontando para
# {APP_URL}/api/billing/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price recorrente do preço único (lib/billing/preco.ts: R$ 97,00/mês) em BRL,
# com imposto EMBUTIDO (tax_behavior: inclusive) — o Stripe Tax não cobre o Brasil.
STRIPE_PRICE_PRO="price_..."
# ——— Régua de e-mail (reengajamento) ———
# Sem estas duas a régua roda e apenas não envia — o produto não para.
# Crie a chave em resend.com/api-keys e verifique o domínio antes.
RESEND_API_KEY="re_..."
EMAIL_REMETENTE="Nexora <ola@seu-dominio.com.br>"

# ——— Identificação do fornecedor (Decreto 7.962/2013, art. 2º) ———
# Quem presta o serviço: o TITULAR ADULTO. Enquanto faltar qualquer uma, a
# cobrança fica travada e as páginas jurídicas mostram o aviso vermelho.
# Os dados reais ficam SÓ no Railway: o repositório é público.
FORNECEDOR_NOME="Nome civil completo"
# Só os dígitos servem — a tela formata.
FORNECEDOR_DOCUMENTO="00000000000"
FORNECEDOR_ENDERECO="Rua, número, complemento, bairro, cidade/UF, CEP"
FORNECEDOR_EMAIL="contato@seu-dominio.com.br"
# Opcional: sem ela, o encarregado de dados (LGPD art. 41) é o próprio fornecedor.
# FORNECEDOR_ENCARREGADO="Nome civil completo"
