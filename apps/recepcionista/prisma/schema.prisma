generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@nexora/recepcionista-prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Empresa = tenant. Todo dado do sistema pende de companyId (isolamento multiempresa).
model Company {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String
  // Estrutura para cobrança futura por plano (trial | pro | business)
  plan         String   @default("trial")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        CompanyProfile?
  conversations  Conversation[]
  leads          Lead[]
  knowledgeGaps  KnowledgeGap[]
  knowledgeItems KnowledgeItem[]

  // Base de clientes e o que roda em cima dela
  customers    Customer[]
  services     Service[]
  appointments Appointment[]
  touches      RecoveryTouch[]
  recoveries   RecoveryEntry[]

  // Identificador público da página de agendamento: nexora.app/agendar/{slug}
  slug String? @unique

  // ——— Cobrança (Stripe) ———
  // A assinatura é 1:1 com Company, que já é o tenant. Model separado só
  // acrescentaria um join em toda checagem de acesso.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // trialing | active | past_due | paused | canceled | incomplete
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  trialEndsAt          DateTime?
  // card | boleto — a Stripe no Brasil não faz Pix recorrente.
  paymentMethodType    String?
  // CPF/CNPJ do cliente, para a NFS-e que é emitida FORA da Stripe.
  taxId                String?

  // Dunning. Escritos SÓ por invoice.payment_failed, que nunca toca em
  // subscriptionStatus — status tem um escritor único, customer.subscription.*.
  falhasSeguidas       Int       @default(0)
  dunningIniciadoEm    DateTime?
  ultimoErroPagamento  String?

  // Carrinho abandonado: gravado quando o dono abre o Checkout, apagado quando
  // a assinatura nasce. Sem isso não dá para saber quem chegou até a tela de
  // pagamento e desistiu — que é a lista mais quente que existe.
  checkoutAbertoEm DateTime?
  canceladoEm      DateTime?

  // Ele pediu para não receber e-mail da Nexora. Diferente do opt-out do
  // cliente final; este é o dono da conta.
  semEmail Boolean @default(false)

  // ACEITE DOS DOCUMENTOS. Consentimento sem data e sem VERSAO nao prova nada:
  // se o texto mudar depois, ninguem consegue dizer o que a pessoa aceitou.
  // O termo antigo afirmava que o aceite ficava em `organizations.lgpdAcceptedAt`
  // -- coluna que nunca existiu neste produto. Agora existe, e e gravada.
  termosAceitosEm DateTime?
  termosVersao    String?

  // Confirmacao da contratacao (Decreto 7.962/2013, art. 4o, V). Marca de
  // envio unico: aplicarAssinatura roda a cada evento da Stripe e reentrega e
  // rotina -- sem isto o dono receberia a mesma confirmacao a cada webhook.
  confirmacaoEnviadaEm DateTime?

  // IDENTIDADE DO GOOGLE, e nao apenas o e-mail.
  //
  // O callback achava a empresa por `where: { email }` e abria sessao. Como o
  // cadastro por senha aceita QUALQUER e-mail sem confirmar posse, um atacante
  // cadastrava o e-mail comercial do alvo e esperava: quando o dono real
  // entrasse pelo Google, caia dentro da conta do atacante e importava a base
  // dele la. E-mail nao e identidade; o `sub` do Google e.
  googleSub         String?   @unique
  emailVerificadoEm DateTime?

  // EPOCA DA SESSAO. O JWT dura 7 dias e nao tinha revogacao: trocar a senha
  // so reescrevia o hash e o logout so apagava o cookie do proprio navegador.
  // Quem roubasse o cookie ficava dentro por uma semana, inclusive DEPOIS de a
  // vitima trocar a senha. Incrementar isto invalida todos os tokens de uma vez.
  sessaoEpoca Int @default(0)

  reengajamentos Reengajamento[]
  passwordResets PasswordReset[]
  importacoes    RegistroImportacao[]
  supressoes     Supressao[]
}

// Cada e-mail de reengajamento já enviado. A unicidade por (empresa, momento) é
// o que impede o motor de mandar a mesma mensagem duas vezes — e-mail repetido
// não é insistência, é o que faz o dono marcar como spam e nunca mais receber
// nada, inclusive o aviso de cobrança.
model Reengajamento {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  momento   String
  enviadoEm DateTime @default(now())
  canal     String   @default("email")
  erro      String?

  @@unique([companyId, momento])
  @@index([companyId, enviadoEm])
}

// Evento da Stripe já visto. A Stripe REENVIA eventos e não garante ordem de
// entrega — sem isto, um retry de `invoice.paid` registra a receita duas vezes
// e corrompe exatamente a North Star (Receita Recuperada comprovada).
//
// `id` é a PK justamente para que o `create` seja a reivindicação atômica: só
// ele estoura P2002 sob corrida. Um `upsert` aqui seria inútil — por definição
// ele atualiza em vez de falhar, e as duas entregas concorrentes passariam.
//
// `processedAt` só é gravado DEPOIS do efeito colateral dar certo. Marcar antes
// perderia o evento para sempre quando o handler falhasse.
// Pedido de redefinição de senha.
//
// O token é gravado com HASH, nunca em claro: se o banco vazar, os hashes não
// permitem redefinir a senha de ninguém — do contrário o vazamento viraria
// tomada de conta imediata em toda conta com pedido em aberto.
//
// `usedAt` torna o link de uso único. Sem isso, quem tivesse acesso ao e-mail
// (ou ao histórico do navegador) poderia redefinir de novo depois.
model PasswordReset {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(1)
  companyId   String?
  erro        String?

  @@index([processedAt])
}

// Base de conhecimento da IA — tudo que a recepcionista sabe vem daqui.
model CompanyProfile {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  description      String @default("")
  address          String @default("")
  productsServices String @default("")
  pricingInfo      String @default("")
  paymentMethods   String @default("")
  serviceRules     String @default("")
  aiTone           String @default("profissional, simpático e objetivo")
  greetingMessage  String @default("")
  awayMessage      String @default("")

  // [{ day: 0-6, open: "08:00", close: "18:00", closed: false }]
  businessHours   Json @default("[]")
  // [{ question, answer }]
  faqs            Json @default("[]")
  // ["falar com atendente", "reclamação", ...]
  handoffKeywords Json @default("[]")

  // KUS: áreas de atuação da empresa — a IA só SUGERE hipóteses; quem decide
  // (e pode escolher mais de uma) é sempre a empresa. ["Academia", "Loja..."]
  segments           Json      @default("[]")
  interviewStartedAt DateTime?

  followUpEnabled    Boolean @default(false)
  followUpDelayHours Int     @default(4)
  followUpMessage    String  @default("")
  maxFollowUps       Int     @default(2)

  // Conexão WhatsApp (Evolution API) — uma instância por empresa (nexora-{companyId})
  whatsappInstance    String?   @unique
  whatsappStatus      String    @default("DISCONNECTED") // DISCONNECTED | WAITING_QR | CONNECTED | ERROR
  whatsappQrCode      String?   // data URL base64 do QR atual, enquanto aguarda leitura
  whatsappConnectedAt DateTime?
  whatsappError       String?
}

enum ConversationStatus {
  AI
  WAITING_HUMAN
  HUMAN
  FINISHED
}

enum MessageRole {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

model Conversation {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName  String?
  status        ConversationStatus @default(AI)

  followUpCount         Int       @default(0)
  lastCustomerMessageAt DateTime?
  lastFollowUpAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  lead     Lead?

  @@unique([companyId, customerPhone])
  @@index([companyId, status])
  @@index([companyId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // Dedupe de retries do webhook da Evolution
  whatsappMessageId String? @unique
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model Lead {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  interest       String?
  createdAt      DateTime     @default(now())

  @@index([companyId, createdAt])
}

// ——— NALS: Treinamento do Atendente ———
// Regra absoluta: o Atendente só usa conhecimento APPROVED. Todo o resto é
// observação/registro que aguarda decisão da empresa. Nunca: Detectado→Utilizado.

enum KnowledgeStatus {
  OBSERVED         // capturado do atendimento da equipe — nunca usado sem aprovação
  PENDING_APPROVAL // resposta dada no treinamento, aguardando confirmação
  APPROVED         // único estado que entra no conhecimento do Atendente
  REJECTED
}

// Pergunta que o Atendente não soube responder — registrada em silêncio
model KnowledgeGap {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questionKey String   // normalizada para deduplicar variações da mesma dúvida
  question    String   // exemplo mais recente, como o cliente escreveu
  source      String   @default("CUSTOMER") // CUSTOMER (clientes reais) | INTERVIEW (integração)
  reason      String   @default("")
  askCount    Int      @default(1)
  status      String   @default("OPEN") // OPEN | ANSWERED | DISMISSED
  lastAskedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  items KnowledgeItem[]

  @@unique([companyId, questionKey])
  @@index([companyId, status, askCount])
}

// Conhecimento estruturado (pergunta → resposta) com ciclo de aprovação
model KnowledgeItem {
  id         String          @id @default(cuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  source     String          // TRAINING | TEAM_OBSERVATION
  status     KnowledgeStatus
  gapId      String?
  gap        KnowledgeGap?   @relation(fields: [gapId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  approvedAt DateTime?

  @@index([companyId, status])
}

// KUS: Template Universal de segmento — pertence à NEXORA (global, nunca da
// empresa). Semeado pela curadoria ou gerado por IA UMA vez e reutilizado.
// Nunca vira resposta pronta: só orienta entrevista, vocabulário e treinamento.
model SegmentTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique // "academia", "restaurante"...
  name      String   // "Academia"
  topics    Json     // [{ topic: "Plano mensal", question: "Vocês oferecem plano mensal? Como funciona?" }]
  source    String   @default("SEED") // SEED (curadoria Nexora) | AI_GENERATED
  createdAt DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  companyId String?
  context   String
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// BASE DE CLIENTES + AGENDA + RECUPERAÇÃO
// ----------------------------------------------------------------------------
// A base de clientes é o ativo da Nexora: todo módulo (agenda, recuperação,
// cobrança) roda em cima dela. Ela se forma sozinha por dois caminhos — o
// cliente final marcando pela página pública, e o Resgate do Caderno
// (importação da base histórica). O dono nunca digita cliente.
// ============================================================================

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  phone String

  // Como entrou na base — importante para medir se a Base Viva está funcionando.
  // LINK (agendou sozinho) | IMPORT (Resgate do Caderno) | MANUAL
  source String @default("LINK")

  notes String @default("")

  // Opt-out do Protocolo 4 Toques. Respeitar é exigência do CDC/LGPD e o
  // toque 4 sempre oferece a saída explicitamente.
  optOut   Boolean   @default(false)
  optOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits       Visit[]
  appointments Appointment[]
  touches      RecoveryTouch[]
  recoveries   RecoveryEntry[]

  @@unique([companyId, phone])
  @@index([companyId])
}

// Visita concluída. É daqui que sai o ciclo pessoal de cada cliente — sem
// histórico de visitas não existe Esteira 2 nem 3, e a recuperação volta a
// ser lista estática.
model Visit {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  occurredAt DateTime
  valueCents Int      @default(0)
  service    String   @default("")

  createdAt DateTime @default(now())

  @@index([customerId, occurredAt])
}

model Service {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  durationMin Int     @default(30)
  priceCents  Int     @default(0)
  active      Boolean @default(true)
  // true quando veio pré-preenchido do SegmentTemplate e o dono ainda não
  // revisou — permite avisar sem bloquear o uso.
  suggested   Boolean @default(false)

  order Int @default(0)

  appointments Appointment[]

  @@index([companyId, active])
}

model Appointment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  startsAt DateTime
  endsAt   DateTime

  // MARCADO | CONFIRMADO | ATENDIDO | FALTOU | CANCELADO
  status String @default("MARCADO")

  // LINK (cliente marcou sozinho) | PAINEL (dono marcou)
  source String @default("LINK")

  notes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startsAt])
  @@index([customerId])
}

// Um toque do Protocolo 4 Toques. Quatro a cinco tentativas recuperam ~81% a
// mais que uma só — por isso o sistema guarda em qual toque cada cliente está.
model RecoveryTouch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  touchNumber Int
  // RESGATE | ATRASO | PRE_ATRASO — de qual esteira o cliente veio
  esteira     String

  sentAt DateTime @default(now())

  // AGUARDANDO | VOLTOU | MARCOU | RESPONDEU | SEM_RESPOSTA | PULADO
  outcome   String    @default("AGUARDANDO")
  outcomeAt DateTime?
  // motivo quando PULADO: MUDOU_CIDADE | NAO_E_CLIENTE | FALECEU | EVENTO | OUTRO
  skipReason String   @default("")

  @@index([companyId, sentAt])
  @@index([customerId, touchNumber])
}

// Livro-Caixa da Recuperação: extrato do que voltou de verdade. Só entra o que
// foi marcado com valor pela mão do dono ou chegou por agendamento rastreável.
// Nada é inferido — inflar o extrato é a forma mais rápida de perder o cliente.
model RecoveryEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // NULAVEL de proposito. Quando um titular pede exclusao (art. 18, VI), a
  // pessoa some mas o VALOR fica: RecoveryEntry e o Livro-Caixa do dono,
  // registro financeiro dele, e apagar reescreveria o faturamento passado --
  // sendo que Receita Recuperada comprovada e o North Star do produto.
  // SetNull anonimiza; Cascade apagaria. A diferenca entre as duas palavras e
  // a diferenca entre respeitar o titular e destruir a contabilidade do dono.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  returnedAt DateTime @default(now())
  valueCents Int

  daysAway    Int
  esteira     String
  touchNumber Int

  // true quando o retorno caiu na janela de atribuição (21 dias do contato E
  // cliente estava além de 1,5x o ciclo). Fora disso conta como "voltou sem
  // atribuição", em coluna separada.
  attributed Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([companyId, returnedAt])
}

// REGISTRO DA OPERACAO DE TRATAMENTO -- LGPD art. 37.
//
// A rota de importacao ja exigia o `confirmo` ("estes clientes sao meus e eu
// posso falar com eles") e ja recusava gravar sem ele -- mas nao guardava a
// declaracao em lugar nenhum. O comentario do codigo afirmava que registrava.
// Declaracao que ninguem consegue provar depois nao protege o operador: se um
// titular reclamar na ANPD, a pergunta e "com que base legal esses dados
// entraram", e a resposta precisa ter data.
model RegistroImportacao {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // O texto exato da declaracao aceita, nao um booleano. Se a frase mudar, o
  // registro antigo continua provando o que a pessoa leu naquele dia.
  declaracao String
  versao     String

  clientesLidos    Int @default(0)
  clientesCriados  Int @default(0)
  visitasCriadas   Int @default(0)
  // Origem detectada pelo parser: PLANILHA | CONVERSA | LISTA
  origem String @default("")

  criadoEm DateTime @default(now())

  @@index([companyId, criadoEm])
}

// LISTA DE SUPRESSAO -- o opt-out que sobrevive a exclusao.
//
// Quem responde PARAR e depois pede para ser apagado some do banco. Na proxima
// vez que o dono importar a MESMA planilha, essa pessoa volta e e contatada de
// novo: a exclusao teria desfeito o direito exercido. Aqui fica o HMAC do
// telefone -- suficiente para reconhecer e barrar, insuficiente para contatar.
model Supressao {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // HMAC-SHA256 do telefone canonico. Nunca o numero.
  telefoneHash String

  criadoEm DateTime @default(now())

  @@unique([companyId, telefoneHash])
  @@index([companyId])
}
