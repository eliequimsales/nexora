# ─────────────────────────────────────────────
# Nexora App (Next.js) — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit the real .env.local to version control.
# ─────────────────────────────────────────────

# ── API URL ───────────────────────────────────
# Must point to the running NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stripe price IDs (get from Stripe Dashboard → Products)
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=price_...
