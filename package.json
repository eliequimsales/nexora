{
  "name": "saas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora — IA que recupera clientes perdidos automaticamente",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:app": "pnpm --filter app dev",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:app": "pnpm --filter app build",
    "test:api": "pnpm --filter api test",
    "test:api:e2e": "pnpm --filter api test:e2e",
    "typecheck:app": "pnpm --filter app typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "dependencies": {
    "axios": "^1.16.0"
  }
}
